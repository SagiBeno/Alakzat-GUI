<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER" minHeight="480" minWidth="640" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.alakzatgui.AlakzatController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>


    <VBox maxHeight="250.0" prefHeight="198.0" prefWidth="200">
        <HBox maxHeight="250.0">
            <VBox prefWidth="150">
                <RadioButton minWidth="100.0" onAction="#onPirosSelected" text="Piros">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <toggleGroup>
                  <ToggleGroup fx:id="togglegroup_Szin" />
               </toggleGroup></RadioButton>
                <RadioButton minWidth="100.0" onAction="#onZoldSelected" text="Zöld" toggleGroup="$togglegroup_Szin">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin></RadioButton>
                <RadioButton minWidth="100.0" onAction="#onKekSelected" text="Kék" toggleGroup="$togglegroup_Szin">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin></RadioButton>
            </VBox>
            <VBox prefWidth="150">
                <RadioButton onAction="#onNegyzetSelected" text="Négyzet">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <toggleGroup>
                  <ToggleGroup fx:id="togglegroup_Alakzat" />
               </toggleGroup></RadioButton>
                <RadioButton onAction="#onKorSelected" text="Kör" toggleGroup="$togglegroup_Alakzat">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin></RadioButton>
                <RadioButton onAction="#onHaromszogSelected" text="Háromszög" toggleGroup="$togglegroup_Alakzat">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin></RadioButton>
            </VBox>
        </HBox>
      <Pane id="pane_Alakzat" fx:id="pane_Alakzat" maxHeight="178.0" maxWidth="200.0" prefHeight="169.0" prefWidth="200.0">
         <children>
            <ImageView id="imageview_Alakzat" fx:id="imageview_Alakzat" fitHeight="132.0" fitWidth="153.0" layoutX="34.0" layoutY="19.0" pickOnBounds="true" preserveRatio="true" />
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </Pane>
    </VBox>
    <VBox alignment="TOP_CENTER" maxHeight="250.0" prefWidth="200">
      <children>
         <HBox alignment="BOTTOM_CENTER" prefHeight="87.0" prefWidth="280.0">
            <children>
               <Button minWidth="100.0" mnemonicParsing="false" text="Hozzáad">
                  <HBox.margin>
                     <Insets bottom="10.0" right="70.0" />
                  </HBox.margin>
               </Button>
               <Button minWidth="100.0" mnemonicParsing="false" text="Töröl">
                  <HBox.margin>
                     <Insets bottom="10.0" left="10.0" top="5.0" />
                  </HBox.margin>
               </Button>
            </children>
         </HBox>
         <ListView id="listview_Listview" fx:id="listview_Listview" maxWidth="350.0" prefHeight="280.0" prefWidth="274.0" />
         <Button alignment="TOP_LEFT" mnemonicParsing="false" text="Mentés">
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin>
         </Button>
      </children></VBox>
</HBox>
